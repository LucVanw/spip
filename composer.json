{
    "name": "spip/spip",
    "description": "Système de Publication pour l’Internet",
    "license": "GPL-3.0-only",
    "type": "project",
    "keywords": [
        "cms",
        "spip"
    ],
    "require": {
        "php": "^8.2",
        "spip-league/composer-installer": "dev-plugin_config as 0.8",
        "spip-league/console": "@dev",
        "spip-league/http-kernel": "dev-plugin_config as 1.0.x-dev",
        "spip-league/kernel": "dev-plugin_config as 2.1",
        "spip-league/pipeline-bridge": "@dev",
        "spip/classic-distribution": "^5.0",
        "spip/aide": "dev-plugin_config as 4.0.x-dev",
        "spip/archiviste": "dev-plugin_config as 3.0.x-dev",
        "spip/bigup": "dev-plugin_config as 4.x-dev",
        "spip/compagnon": "dev-plugin_config as 4.x-dev",
        "spip/compresseur": "dev-plugin_config as 3.x-dev",
        "spip/dump": "dev-plugin_config as 3.0",
        "spip/ecrire": "dev-plugin_config as 5.0",
        "spip/forum": "dev-plugin_config as 4.x-dev",
        "spip/frontend": "dev-plugin_config as 5.x-dev",
        "spip/images": "dev-plugin_config as 5.x-dev",
        "spip/mediabox": "dev-plugin_config as 4.0.x-dev",
        "spip/medias": "dev-plugin_config as 5.0.x-dev",
        "spip/mots": "dev-plugin_config as 5.0",
        "spip/plan": "dev-plugin_config as 5.x-dev",
        "spip/porte-plume": "dev-plugin_config as 4.x-dev",
        "spip/prive": "dev-plugin_config as 2.x-dev",
        "spip/revisions": "dev-plugin_config as 4.x-dev",
        "spip/safehtml": "dev-plugin_config as 4.x-dev",
        "spip/security": "dev-spip-5 as 1.6",
        "spip/sites": "dev-plugin_config as 5.0",
        "spip/stats": "dev-plugin_config as 4.x-dev",
        "spip/svp": "dev-plugin_config as 4.x-dev",
        "spip/tw": "dev-plugin_config as 4.x-dev",
        "spip/urls": "dev-plugin_config as 5.x-dev",
        "symfony/runtime": "^7.4",
        "symfony/polyfill-php83": "^1.31",
        "symfony/polyfill-php84": "^1.31"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.4",
        "symfony/var-dumper": "^7.4"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://get.spip.net/composer",
            "name": "spip"
        }
    ],
    "minimum-stability": "dev",
    "autoload-dev": {
        "psr-4": {
            "Spip\\Test\\": "ecrire/tests/integration/"
        }
    },
    "bin": [
        "bin/spip"
    ],
    "archive": {
        "name": "spip",
        "exclude": [
            "!/ecrire",
            "!/plugins-dist",
            "!/prive",
            "!/squelettes-dist",
            "!/vendor"
        ]
    },
    "config": {
        "allow-plugins": {
            "spip-league/composer-installer": true,
            "symfony/runtime": true
        },
        "platform": {
            "php": "8.2.30"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "5.0.x-dev"
        },
        "spip": {
            "back_office": "spip/ecrire",
            "extensions": [
                "spip/aide",
                "spip/archiviste",
                "spip/bigup",
                "spip/compagnon",
                "spip/compresseur",
                "spip/dump",
                "spip/images",
                "spip/forum",
                "spip/frontend",
                "spip/mediabox",
                "spip/medias",
                "spip/mots",
                "spip/plan",
                "spip/porte-plume",
                "spip/revisions",
                "spip/safehtml",
                "spip/sites",
                "spip/stats",
                "spip/svp",
                "spip/tw",
                "spip/urls"
            ],
            "private_template": "spip/prive",
            "template": "spip/dist"
        }
    }
}
