{
    "name": "spip/spip",
    "description": "Système de Publication pour l'Internet",
    "license": "GPL-3.0-only",
    "type": "project",
    "keywords": [
        "cms",
        "spip"
    ],
    "require": {
        "php": "^8.4",
        "spip-league/composer-installer": "2.x-dev",
        "spip-league/console": "1.x-dev",
        "spip/classic-distribution": "^5.x-dev",
        "spip/framework": "5.x-dev",
        "symfony/runtime": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.2",
        "symfony/var-dumper": "^8.1"
    },
    "repositories": [
        {
            "name": "spip",
            "type": "composer",
            "url": "https://get.spip.net/composer"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload-dev": {
        "psr-4": {
            "Spip\\Test\\": "ecrire/tests/integration/"
        }
    },
    "bin": [
        "bin/spip"
    ],
    "archive": {
        "name": "spip",
        "exclude": [
            "!/ecrire",
            "!/plugins-dist",
            "!/prive",
            "!/squelettes-dist",
            "!/vendor"
        ]
    },
    "config": {
        "allow-plugins": {
            "spip-league/composer-installer": true,
            "symfony/runtime": true
        },
        "platform": {
            "php": "8.4.22"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "5.0.x-dev"
        },
        "spip": {
            "back_office": "spip/ecrire",
            "extensions": [
                "spip/aide",
                "spip/archiviste",
                "spip/bigup",
                "spip/compagnon",
                "spip/compresseur",
                "spip/dump",
                "spip/images",
                "spip/forum",
                "spip/frontend",
                "spip/mediabox",
                "spip/medias",
                "spip/mots",
                "spip/plan",
                "spip/porte-plume",
                "spip/revisions",
                "spip/safehtml",
                "spip/sites",
                "spip/stats",
                "spip/svp",
                "spip/tw",
                "spip/urls"
            ],
            "private_template": "spip/prive",
            "template": "spip/dist"
        }
    }
}
